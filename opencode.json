{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
      "@slkiser/opencode-quota@latest",
      "opencode-mem",
      "@dietrichgebert/ponytail"
  ],
  "lsp": true,
  "mcp": {
      "codegraph": {
          "type": "local",
          "command": ["codegraph", "serve", "--mcp"],
          "enabled": true
      },
      "docs-langchain": {
          "type": "remote",
          "url": "https://docs.langchain.com/mcp",
          "enabled": true
      },
      "reference-langchain": {
          "type": "remote",
          "url": "https://reference.langchain.com/mcp",
          "enabled": true
      },
      "context7": {
          "type": "remote",
          "url": "https://mcp.context7.com/mcp",
          "enabled": true
      }
  },
  "default_agent": "auto-build",
  "agent": {
    "safe-build": {
      "mode": "primary",
      "description": "Work on this project with confirmation before code edits and most shell commands.",
      "permission": {
        "edit": "ask",
        "bash": {
          "*": "ask",
          "git status*": "allow",
          "git diff*": "allow",
          "docker compose exec -T backend php artisan test*": "allow",
          "docker compose exec -T backend ./vendor/bin/pint*": "allow"
        }
      }
    },
    "coder": {
      "description": "Implements bounded coding tasks spanning related components or requiring substantial investigation and verification.",
      "mode": "subagent",
      "model": "openai/gpt-6.1-sol",
      "variant": "xhigh",
      "permission": {
        "edit": "allow",
        "bash": {
          "*": "allow",
          "git push*": "deny",
          "git * push*": "deny"
        },
        "task": "deny"
      },
      "prompt": "Implement the assigned task using AGENTS.md and relevant contracts. Inspect implementation and callers; preserve existing user changes. Choose implementation details within the assigned scope. If broader edits or unresolved product/architecture decisions are required, report the blocker to the primary agent. Make the smallest correct change, run applicable checks and return the concise report specified in AGENTS.md. Do not commit, push or bypass tool permissions."
    },
    "auto-build": {
        "mode": "primary",
        "description": "Work autonomously inside this project. Do not push to remote repositories or access external directories except OpenCode's temporary output directory.",
        "permission": {
            "edit": "allow",
            "read": "allow",
            "glob": "allow",
            "grep": "allow",
            "list": "allow",
            "lsp": "allow",
            "task": "allow",
            "todowrite": "allow",
            "question": "allow",
            "webfetch": "allow",
            "websearch": "allow",
            "skill": "allow",
            "bash": {
                "*": "allow",
                "git push*": "deny",
                "git * push*": "deny"
            },
            "external_directory": {
                "*": "deny",
                "/tmp/opencode": "allow",
                "/tmp/opencode/**": "allow"
            }
        }
    }
  }
}
